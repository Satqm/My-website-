async function activateLicense() {
    const licenseKey = licenseKeyInput.value.trim();
    
    if (!licenseKey) {
        showLicenseMessage('Please enter a license key', 'error');
        return;
    }
    
    // Show loading state
    const activateBtn = document.getElementById('activate-btn');
    const originalText = activateBtn.innerHTML;
    const originalWidth = activateBtn.style.width;
    
    activateBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Validating...';
    activateBtn.disabled = true;
    activateBtn.style.width = activateBtn.offsetWidth + 'px';
    
    try {
        // First, check if the license has the correct format
        if (!licenseKey.startsWith('CA-PRO-')) {
            showLicenseMessage('Invalid format. Must start with CA-PRO-', 'error');
            
            // Try to fix common format issues
            if (licenseKey.startsWith('CA-PREM-')) {
                const fixedKey = licenseKey.replace('CA-PREM-', 'CA-PRO-PREMIUM-');
                showLicenseMessage(`Did you mean: ${fixedKey.substring(0, 30)}...?`, 'warning');
                licenseKeyInput.value = fixedKey;
            }
            
            return;
        }
        
        // Split the license key to validate structure
        const parts = licenseKey.split('-');
        if (parts.length < 4) {
            showLicenseMessage('Invalid license structure. Expected: CA-PRO-TIER-ENCRYPTED_CODE', 'error');
            return;
        }
        
        const validation = EnhancedLicenseSystem.validateLicense(licenseKey);
        
        if (!validation.valid) {
            // Show specific error message
            let errorMessage = validation.error;
            let errorType = 'error';
            
            switch(validation.code) {
                case 'EXPIRED':
                    errorMessage = `License expired on ${new Date(validation.expiry).toLocaleDateString()}. Please renew.`;
                    errorType = 'warning';
                    break;
                case 'DEVICE_MISMATCH':
                    errorMessage = 'This license is registered to another device. Please contact support.';
                    errorType = 'warning';
                    break;
                case 'FORMAT_ERROR':
                    errorMessage = 'Invalid license format. Should be: CA-PRO-PREMIUM-XXXXXX';
                    break;
                case 'DECRYPT_ERROR':
                    errorMessage = 'Invalid license key. Check for typos.';
                    break;
            }
            
            showLicenseMessage(errorMessage, errorType);
            
            // Show detailed error in console for debugging
            console.error('License validation failed:', validation);
            
            return;
        }
        
        // Valid license - Save with enhanced data
        DataStorage.save('license', {
            key: licenseKey,
            activated: new Date().toISOString(),
            validation: validation,
            deviceId: EnhancedLicenseSystem.getDeviceId(),
            originalKey: licenseKey
        });
        
        // Set current user
        currentUser = {
            name: validation.data.name,
            initials: validation.data.name.split(' ').map(n => n[0]).join('').toUpperCase(),
            licenseType: validation.type,
            expiry: validation.expiry,
            daysRemaining: validation.daysRemaining,
            deviceId: validation.data.deviceId
        };
        
        DataStorage.save('user', currentUser);
        
        // Show success animation
        showLicenseMessage(`✅ License activated! Welcome ${currentUser.name}!`, 'success');
        
        // Add visual success animation
        const licenseBox = document.querySelector('.license-box');
        const originalTransform = licenseBox.style.transform;
        const originalBoxShadow = licenseBox.style.boxShadow;
        
        licenseBox.style.transform = 'scale(1.02)';
        licenseBox.style.boxShadow = '0 30px 60px rgba(46, 204, 113, 0.3)';
        
        // Success confetti effect
        createConfetti();
        
        // Transition to app
        setTimeout(() => {
            licenseContainer.style.display = 'none';
            appContainer.style.display = 'block';
            appContainer.classList.add('active');
            
            setupEventListeners();
            loadUserData();
            setupNotifications();
            
            // Show welcome toast with license info
            showToast(`🎉 Welcome ${currentUser.name}! Premium license activated. ${validation.daysRemaining} days remaining.`, 'success');
            
            // Update user status in header
            updateLicenseStatusUI();
            
            // Reset license box style
            setTimeout(() => {
                licenseBox.style.transform = originalTransform;
                licenseBox.style.boxShadow = originalBoxShadow;
            }, 1000);
            
        }, 2000);
        
    } catch (error) {
        console.error('License activation error:', error);
        showLicenseMessage(`❌ Activation failed: ${error.message}`, 'error');
    } finally {
        // Reset button
        setTimeout(() => {
            activateBtn.innerHTML = originalText;
            activateBtn.disabled = false;
            activateBtn.style.width = originalWidth;
        }, 1000);
    }
}
